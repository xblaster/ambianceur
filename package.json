{
  "name": "ambianceur",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @ambianceur/app build && pnpm --parallel --filter @ambianceur/server --filter @ambianceur/app dev",
    "build": "pnpm --filter @ambianceur/app build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm build && pnpm --filter @ambianceur/server run deploy",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "typescript": "^5.9.0"
  }
}
